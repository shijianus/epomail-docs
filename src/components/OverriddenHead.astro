---
import DefaultHead from '@astrojs/starlight/components/Head.astro';

const { entry, siteTitle } = Astro.locals.starlightRoute;
// Use the same content-route identity as Starlight's 404/pagefind guard,
// not the requested URL: hosts also serve this page for arbitrary missing URLs.
const isNotFound = entry.slug === '404' || entry.slug.endsWith('/404');
const favicon = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`;
---

{
  isNotFound ? (
    <>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>{entry.data.title} | {siteTitle}</title>
      <meta name="robots" content="noindex, follow" />
      <link rel="icon" type="image/svg+xml" href={favicon} />
    </>
  ) : (
    <DefaultHead />
  )
}
